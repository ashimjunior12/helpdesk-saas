# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGIN=http://localhost:3000

# ── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/helpdesk

# ── Logging ────────────────────────────────────────────
# One of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# ── Auth (JWT) ─────────────────────────────────────────
# Signing secrets for access and refresh tokens. Use long, random, DISTINCT
# values (e.g. `openssl rand -base64 48`). Minimum 32 characters each.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32
# Token lifetimes (ms-style durations, e.g. 15m, 1h, 7d).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Redis / background jobs (optional) ─────────────────
# When set, background jobs (notifications, ...) run through BullMQ on this Redis.
# When unset, those jobs run inline (no Redis needed for dev/tests).
# REDIS_URL=redis://127.0.0.1:6379

# Platform super admin, seeded at startup if none exists. Change the password
# after first login.
SUPER_ADMIN_EMAIL=ashimjunior12@gmail.com
SUPER_ADMIN_PASSWORD=Random123
