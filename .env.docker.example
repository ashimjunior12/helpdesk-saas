# Copy to .env (next to docker-compose.yml) and set real values before `docker compose up`.

# Long random, DISTINCT secrets (e.g. `openssl rand -base64 48`), min 32 chars each.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32

# Origins allowed to call the API (comma-separated). Must match where you open
# the app (the Docker frontend is published on port 3000).
CORS_ORIGIN=http://localhost:3000

# Base URL the frontend uses to reach the API (baked into the client at build).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
